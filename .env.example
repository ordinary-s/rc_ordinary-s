# Local-only examples. Copy to .env; replace these values for any shared environment.
MYSQL_ROOT_PASSWORD=notification-root-local
MYSQL_APP_PASSWORD=notification-app-local
CLIENT_TOKEN=demo-client-token
ADMIN_TOKEN=demo-admin-token
ADMIN_ACTOR=local-admin
DELIVERY_BUDGET=90s
MQ_CONSUME_TIMEOUT=2m
APP_BIND=127.0.0.1
APP_PORT=8080
MQ_MAX_RECONSUME=8
